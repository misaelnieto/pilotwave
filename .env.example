# Copy to .env — `just` loads it automatically (set dotenv-load).
# Both Django (host project) and the Rust worker read their config from env.
# The worker reads ONLY the PILOTWAVE_*, EMAIL_* and DEFAULT_FROM_EMAIL keys.

# ── Development database (docker compose, see compose.yaml) ─────────────
# Full-privilege DSN used by Django migrations / producer code.
DATABASE_URL=postgres://pilotwave:pilotwave@localhost:5432/pilotwave
PILOTWAVE_DB_NAME=pilotwave
PILOTWAVE_DB_USER=pilotwave
PILOTWAVE_DB_PASSWORD=pilotwave
PILOTWAVE_DB_HOST=localhost
PILOTWAVE_DB_PORT=5432

# ── Worker database (least privilege, required by the real worker) ──────
# The sidecar must NOT use DATABASE_URL. Grant only:
#   GRANT SELECT, UPDATE ON django_tasks_database_dbtaskresult TO pilotwave_worker;
#   GRANT INSERT, UPDATE ON pilotwave_heartbeat TO pilotwave_worker;
PILOTWAVE_DATABASE_URL=postgres://pilotwave_worker:CHANGEME@localhost:5432/pilotwave

# ── CLI read-only (R-7: `status`/`list`/`inspect` usan este DSN si existe) ──
# Rol de solo lectura para operar sin capacidad de escritura/claim:
#   CREATE ROLE pilotwave_reader LOGIN PASSWORD 'CHANGEME';
#   GRANT CONNECT ON DATABASE pilotwave TO pilotwave_reader;
#   GRANT SELECT ON django_tasks_database_dbtaskresult TO pilotwave_reader;
#   GRANT SELECT ON pilotwave_heartbeat TO pilotwave_reader;
# Ausente o vacío = el CLI reutiliza PILOTWAVE_DATABASE_URL.
# PILOTWAVE_DATABASE_URL_RO=postgres://pilotwave_reader:CHANGEME@localhost:5432/pilotwave
# Nota: fuera de localhost el DSN exige ?sslmode=require (auditoría 001 A02;
# si no, el worker falla alto). El loopback se permite con WARNING (solo dev).

# ── Queue / identity ─────────────────────────────────────────────────────
# The shipped task is `pilotwave.tasks.mail_notification` on queue
# `pilotwave.email`. Override only to drain a legacy queue.
PILOTWAVE_TASK_PATHS=pilotwave.tasks.mail_notification
PILOTWAVE_QUEUE_NAME=pilotwave.email
PILOTWAVE_BACKEND_NAME=default
# Stable worker id appended to worker_ids on claim: [A-Za-z0-9_-]{1,64}
# PILOTWAVE_ID=pilotwave-worker-1

# ── Timing (defaults in parentheses) ─────────────────────────────────────
PILOTWAVE_POLL_MIN_MS=1500
PILOTWAVE_POLL_MAX_MS=5000
PILOTWAVE_TASK_TIMEOUT_SECS=30
PILOTWAVE_MAX_ATTEMPTS=5
PILOTWAVE_RECYCLE_N=5000

# ── Attachment policy ────────────────────────────────────────────────────
# Absolute prefixes, comma-separated. Empty/missing = deny all (fail closed).
# No MEDIA_ROOT fallback, not even in dev: wiring explicit roots is the
# Developer/Integrator's responsibility (see docs/05-DEVELOPERS/getting-started.md).
PILOTWAVE_ATTACHMENT_ROOTS=/home/user/apps/pilotwave/media

# ── SMTP (used by the Rust worker) ───────────────────────────────────────
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
# EMAIL_USE_TLS=false exige PILOTWAVE_ALLOW_PLAINTEXT_SMTP=true (solo dev,
# jamás en prod; si falta, el worker falla alto — auditoría 001 A02).
# PILOTWAVE_ALLOW_PLAINTEXT_SMTP=false
# AUTH es obligatorio salvo el caso dev de abajo: user+pass van juntos
# (trim, vacío=ausente); solo uno => el worker falla alto.
EMAIL_HOST_USER=your-user@example.com
EMAIL_HOST_PASSWORD=your-password
# ── SMTP sin AUTH (solo dev: Mailcrab en loopback, jamás en prod) ─────────
# Mailcrab (:1025) no anuncia AUTH: deja USER/PASSWORD vacíos/ausentes y
# activa AMBOS opt-ins. Cualquier otro host, TLS=true, o un solo opt-in
# => el worker falla alto. Riesgo typo: un host mal escrito (p.ej.
# "localhosst") falla alto en vez de enviar sin AUTH fuera de loopback.
# EMAIL_HOST=localhost
# EMAIL_PORT=1025
# EMAIL_USE_TLS=false
# PILOTWAVE_ALLOW_PLAINTEXT_SMTP=true
# PILOTWAVE_ALLOW_ANONYMOUS_SMTP=true
# Booleanos estilo django-environ (case-insensitive): true/1/yes/y/on y
# false/0/no/n/off; otro valor => el worker falla alto.
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL="Pilotwave <noreply@example.com>"

# ── Optional daemon files ────────────────────────────────────────────────
# PILOTWAVE_PID_FILE=/home/user/apps/pilotwave/run/pilotwave-worker.pid
# PILOTWAVE_LOG_FILE=/home/user/logs/pilotwave-worker.log
